# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
.env

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# Data layers: do not commit raw or generated datasets
data/raw/*
!data/raw/.gitkeep
data/bronze/*
!data/bronze/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep
!data/silver/*.json
!data/gold/*_audit.json
!data/gold/*quality_checks.json

# Generated profiling reports are retained as project evidence.
logs/
*.log

# Power BI backups and temporary artefacts
powerbi/*.pbit
powerbi/*.bak
